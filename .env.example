# RPD Web Application — production Docker Compose environment template.
# Copy to `.env` at the repo root (same directory as `docker-compose.yml`)
# and fill in real values. NEVER commit a real `.env` (Standing Decision:
# no secrets in the repo — see root `.gitignore`).
#
# This file is for the PRODUCTION `docker-compose.yml` stack only (P6-T01).
# It is deliberately separate from `backend/.env.example` /
# `frontend/.env.example` (P1/P4, still used for running the API/frontend
# directly on a dev machine, outside Docker) rather than merging into them —
# `docker-compose.yml` substitutes `${VAR}` references from THIS file (via
# Compose's automatic root-`.env` loading) to build each service's
# `environment:` block, using the exact same `RPD_*`/`RPD_OIDC_*`/
# `RPD_MINIO_*`/`RPD_CELERY_*` variable names those two files already
# established — see each variable's comment below for which upstream
# `core/*.py` `pydantic-settings` class reads it.
#
# `docker-compose.yml` also cross-wires some of these into service-specific
# derived values (e.g. `RPD_DATABASE_URL` is assembled INSIDE each backend
# container at startup, from `POSTGRES_*` config below plus a Docker Compose
# secret — see below — never from this file; `RPD_MINIO_ENDPOINT` points at
# the `minio` service name) — you do not need to duplicate host/port
# information yourself.
#
# *** SECRETS (P6-T04) ARE NOT SET IN THIS FILE. *** Postgres password, the
# field-encryption key, and the MinIO access/secret key pair are Docker
# Compose `secrets:` (files under `./secrets/`, mounted read-only at
# `/run/secrets/<name>`), never plain env vars — see `secrets/README.md` for
# what to generate and the config-vs-secret line this app draws. For local
# `make dev` only, `deploy/secrets/generate-dev-secrets.sh` auto-populates
# `secrets/*.txt` with throwaway values; a real deployment must generate its
# own and never reuse those.

# --- Postgres (docker-compose.yml's `postgres` service; config only — the
# password is a secret, see above) ---
POSTGRES_USER=rpd
POSTGRES_DB=rpd

# --- OIDC (core/config.py's OIDCSettings) ---
# Per docs/OPEN_QUESTIONS.md #9 (OPEN as of P6-T01): production issuer/
# audience are not yet confirmed by the client (Entra ID primary, Keycloak
# fallback — see docker-compose.auth.dev.yml for the DEV-only Keycloak
# stack, which this production compose file does not include or depend on).
# None of these four are secrets: RPD_OIDC_CLIENT_ID is a public OAuth2
# client id (see core/oidc.py's own docstring); issuer/audience/jwks_url are
# just which IdP to trust, not credentials. A future confidential client's
# CLIENT SECRET (P6-T03, currently BLOCKED) will be a Docker Compose secret,
# not a line in this file — see docker-compose.yml's `x-backend-image`
# anchor for the already-prepared (commented-out) wiring.
RPD_OIDC_ISSUER=
RPD_OIDC_AUDIENCE=
RPD_OIDC_CLIENT_ID=
# RPD_OIDC_JWKS_URL=   # optional override; auto-discovered otherwise

# --- MinIO (core/minio_config.py's MinioSettings; config only — the
# access/secret key pair is a secret, see above) ---
RPD_MINIO_EXPORTS_BUCKET=rpd-exports
# P6-T06: nightly pg_dump backups (backend/workers/backup_tasks.py) land in
# a SEPARATE bucket from exports, per docs/PROJECT_AND_STACK.md §6's
# "separate bucket, lifecycle-policy retained" wording.
RPD_MINIO_BACKUPS_BUCKET=rpd-backups
RPD_MINIO_BACKUP_RETENTION_DAYS=30

# --- Off-host backup mirror (P7-T06, core/backup_mirror_config.py's
# BackupMirrorSettings) — OPTIONAL. Leave all three blank (as shipped below)
# until Frigoglass has decided on a real off-host destination; the nightly
# `mirror_backups_offhost` Celery beat task deliberately no-ops rather than
# failing when unconfigured. Do NOT put a real hostname/bucket here without
# also following secrets/README.md's "Future slot: off-host backup mirror"
# section for the matching access/secret key pair (those are secrets, never
# plain env vars — see that file's config-vs-secret table). See
# docs/HANDOVER/BACKUP_RESTORE.md §4 for what this does, how to verify it
# is running, and how it fits into the restore procedure.
RPD_BACKUP_MIRROR_ENDPOINT=
RPD_BACKUP_MIRROR_BUCKET=
RPD_BACKUP_MIRROR_SECURE=true

# --- Structured logging (P6-T06, core/logging_config.py's LoggingSettings)
# — optional, has a code-side default (INFO). ---
# RPD_LOG_LEVEL=INFO

# --- Celery task-shape/solver-budget tuning (core/celery_config.py's
# CelerySettings) — optional, both have code-side defaults; uncomment to
# override for this deployment.
# RPD_CELERY_TASK_TIME_LIMIT_SECONDS=900
# RPD_CELERY_CP_SAT_MAX_TIME_IN_SECONDS=60

# --- Reverse proxy (docker-compose.yml's `nginx` service) ---
# Host ports the reverse proxy binds to. HTTP_PORT (80) is redirect-only as
# of P6-T02 (deploy/nginx/default.conf) — it never serves content, only
# 301s to HTTPS. HTTPS_PORT (443) is where TLS actually terminates.
HTTP_PORT=80
HTTPS_PORT=443

# --- TLS certificate/key (docker-compose.yml's `nginx` service, P6-T02) ---
# Paths on the HOST filesystem to a PEM certificate and PEM private key,
# bind-mounted read-only into the `nginx` container at fixed internal paths
# (see docker-compose.yml's `nginx` service `volumes:`). This is an
# on-premise deployment behind Frigoglass's own corporate network (see
# CLAUDE.md) — there is no public-CA/ACME issuance flow assumed here. For a
# REAL deployment, point these at the certificate/key Frigoglass's IT
# department supplies for the app's internal hostname.
#
# For local `make dev` / testing ONLY, `make dev` auto-generates a
# throwaway self-signed pair at ./deploy/tls/dev/{server.crt,server.key}
# (see deploy/tls/generate-dev-cert.sh — clearly commented dev-only, never
# the production artifact) and these defaults point at it. Browsers will
# show an untrusted-certificate warning for the dev cert; that is expected.
# REPLACE THESE TWO PATHS before any real deployment.
RPD_TLS_CERT_PATH=./deploy/tls/dev/server.crt
RPD_TLS_KEY_PATH=./deploy/tls/dev/server.key
