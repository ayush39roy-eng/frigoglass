# RPD Web Application backend — environment template.
# Copy to `.env` (or export directly) for local development.
# NEVER commit a real `.env` (Standing Decision: no secrets in the repo).
#
# This template is for running the API directly on a dev machine, OUTSIDE
# Docker. If you're using the Docker Compose stack instead (`../docker-
# compose.yml`, `make dev`), secrets (DB password, field-encryption key,
# MinIO keys) are NOT set via `.env` at all — see `../secrets/README.md`
# (P6-T04) for that mechanism; this file's plain-env-var values below are
# fine ONLY for this direct-on-a-dev-machine workflow, not for Compose.

# --- Database (P1) ---
RPD_DATABASE_URL=postgresql+asyncpg://rpd:rpd@localhost:5432/rpd
RPD_FIELD_ENCRYPTION_KEY=  # a Fernet key — generate with:
                            #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- OIDC (P3-T02) ---
# Per docs/OPEN_QUESTIONS.md #9 (OPEN — client IT has not yet confirmed IdP /
# provided an app registration): docs/PROJECT_AND_STACK.md assumes Microsoft
# Entra ID as the primary target, Keycloak as local/dev fallback. The values
# below point at the dev Keycloak stood up by ../docker-compose.auth.dev.yml
# (see dev/keycloak/rpd-realm.json for the realm/client/test-user setup).
# Swapping to a real Entra tenant later only requires changing these values —
# backend/core/oidc.py contains no IdP-specific code.
RPD_OIDC_ISSUER=http://localhost:8080/realms/rpd
RPD_OIDC_AUDIENCE=rpd-backend
RPD_OIDC_CLIENT_ID=rpd-backend
# RPD_OIDC_JWKS_URL=   # optional override; auto-discovered from
                        # {issuer}/.well-known/openid-configuration otherwise
