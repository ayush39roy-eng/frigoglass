# RPD Web Application frontend — environment template.
# Copy to `.env.local` for local development. NEVER commit a real `.env` (Standing Decision: no secrets in the repo).
# All build-time-exposed vars MUST be prefixed `VITE_` — anything here ships to the browser bundle, so it must not be a secret.

# Base URL of the FastAPI backend (P3). During P4-T01 there is no backend; this is unused until a surface fetches data.
VITE_API_BASE_URL=http://localhost:8000

# OIDC is handled server-side (P3-T02 / P6-T03). The frontend never holds an IdP client secret.
# If a public OIDC client id is needed for a browser redirect flow, it is added here (public, not secret) when P3-T02 lands.
