{
  "name": "rpd-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "RPD Web Application frontend (Frigoglass) — design system + app shell. P4-T01.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "build:no-budget": "tsc -b && vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview:e2e": "vite preview --mode e2e --outDir dist-e2e --port 5183 --strict-port",
    "test:e2e": "playwright test"
  },
